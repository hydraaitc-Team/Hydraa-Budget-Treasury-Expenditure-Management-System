# HYDRAA - Budget, Treasury & Expenditure Management System
## Environment Variables Template

# Application Port & Host
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL 8.x InnoDB)
DATABASE_URL="mysql://root:1234@127.0.0.1:3306/hydraa_finance?schema=public&connection_limit=10"

# Local Storage Directory (Default to project local storage or Windows Server D:\HYDRAA-Finance-Storage)
STORAGE_ROOT="D:\\Projects\\Hydraa-Budget, Treasury & Expenditure Management System\\storage"

# Security & Session Secrets
JWT_SECRET="HYDRAA_GOVT_TELANGANA_SECURE_JWT_SECRET_2026_PRODUCTION_GRADE"
SESSION_SECRET="HYDRAA_SESSION_SECRET_AUTHENTICATED_TREASURY_OFFICERS_KEY"
JWT_EXPIRATION="8h"
PASSWORD_SALT_ROUNDS=12

# File Upload Constraints
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES="application/pdf,image/jpeg,image/png,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"

